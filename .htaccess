# ============================================================
# Sturmfrei Impro — Apache rules for the web directory
#
# On netcup the git checkout is at the same time the web directory: this
# file therefore sits in the project root and lands at the top of the
# docroot with the deploy. But only public/ is meant to be served.
#
# One rule takes care of that, and it takes care of both things at once:
# every request is rewritten into public/. Whatever does not lie there —
# content/, lib/, sections/, tools/, .git/, README.md, Makefile — is
# therefore not "locked off" but simply not addressable, and ends as a 404.
# A deny list would have to be extended with every new source file; here
# there is nothing to extend.
#
# The security of this setup hangs on exactly that: content/*.json and the
# PHP files in lib/ and sections/ are never served and never executed by
# the server, because they lie outside the served folder.
#
# The price: without mod_rewrite none of it applies. Which is why there is
# an emergency brake for .git below anyway, and Options -Indexes keeps the
# project folder from being listed on the web if things go wrong.
# ============================================================

Options -Indexes
DirectoryIndex index.php index.html

# Wrong address: our own 404 page instead of Apache's English default.
# /404/ is rewritten to public/404/ by the rule below; the status stays 404,
# this is not a redirect.
ErrorDocument 404 /404/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /public/… from outside: one 301 to the clean address. Otherwise every
  # page would be reachable under two addresses, and the canonical only
  # points at one of them.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^public/(.*)$ /$1 [R=301,L]

  # Two files carry the extension search engines expect and are yet produced
  # by PHP: they need the domain from content/site.json and the list of pages
  # from lib/pages.php. Hence a rule each, before the general one below.
  RewriteRule ^sitemap\.xml$ public/sitemap.php [L]
  RewriteRule ^robots\.txt$ public/robots.php [L]

  # Missing trailing slash: /termine → /termine/, one 301.
  #
  # Without this rule, /termine would first be rewritten to public/termine;
  # there it is a folder, and mod_dir appends the slash itself — but to the
  # *rewritten* address. The visitor would briefly see /public/termine/,
  # which the rule at the very top then redirects once more. Two redirects,
  # and the internal path in the address bar in between.
  #
  # Only applies to addresses without a dot (so not a file) and without a
  # trailing slash — which is why it cannot trigger itself.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^.]+[^/])$ /$1/ [R=301,L]

  # Everything else into public/. The condition is not decoration: /termine/
  # becomes public/termine/, DirectoryIndex then kicks in and internally asks
  # for public/termine/index.php — without the condition that would turn into
  # public/public/termine/index.php.
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ------------------------------------------------------------
# Caching
#
# Behind every stylesheet stands its modification time (?v=… from
# asset_versioned() in lib/paths.php). Only these headers make something of
# that: the browser may keep the file for a year and still fetches it again
# the moment the stamp changes. Without them it asks about every file
# individually on every visit — with 17 stylesheets, 9 modules, 4 fonts and
# the photos, that is 304s by the row before the first pixel.
#
# The show photos carry no stamp and need none: they live in folders by
# date, so a different photo there is always a different file. Where the
# filename is fixed and the content can change, on the other hand — logo,
# icons, hero and group photos — the stamp is attached (see asset_versioned
# in sections/hero.php, about.php, head.php and header.php). Without it
# nobody would get to see a replaced photo for a year.
#
# js/ deliberately gets no "immutable": main.js pulls in the remaining
# modules itself, their paths live in its source, and a stamp on the parent
# would only appear to pass an update to slider.js through. A week with
# revalidation is the honest compromise.
#
# The pages themselves never: they are rebuilt on every request, and a
# cached date would be a wrong date.
# ------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|woff2|jpg|jpeg|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# Compression
#
# The pages are text, the stylesheets are text with a lot of comments —
# exactly what gzip takes down to a quarter. Images and fonts are
# deliberately absent from the list: woff2 and jpg are already compressed,
# and a second pass only costs compute.
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml image/svg+xml
</IfModule>

# ------------------------------------------------------------
# Security headers
#
# The policy below is as tight as it can possibly be, and that is not
# strictness but a description: this site loads nothing from third-party
# servers, has no form, no analytics, no font from Google and not a single
# script in the markup. Everything comes from 'self'.
#
# The JSON-LD in the <head> is a <script type="application/ld+json"> and
# therefore a data block, not a script — it is not executed and does not
# fall under script-src. After switching this on, still open every page once
# with the console open.
#
# form-action 'none': there is no form on the site. If one appears later,
# 'self' belongs here.
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# Emergency brake in case mod_rewrite is missing and nothing above applies.
RedirectMatch 404 ^/\.git(/|$)

# ------------------------------------------------------------
# Do not switch this on yet: only once the Let's Encrypt certificate is in
# place. Before that, forcing HTTPS takes the site offline. netcup can also
# handle both in the WCP — if it offers that, it belongs there and not here.
#
# The www form is the right one: the canonical and og:url from
# content/site.json point at https://www.impro-sturmfrei.de/.
# ------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://www.impro-sturmfrei.de/$1 [R=301,L]
#
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
