# So that indentation and line endings do not depend on the editor.
# https://editorconfig.org — read directly by IntelliJ, VS Code and others.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile*]
indent_style = tab

# The sections in sections/ are HTML with holes: their indentation is that of
# the markup, so two like everywhere else. The logic in lib/ and tools/
# indents by four as is usual for PHP — there is no markup there to hang on.
[{lib,tools}/*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
