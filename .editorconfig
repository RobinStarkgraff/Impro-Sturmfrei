# Damit Einrückung und Zeilenenden nicht vom Editor abhängen.
# https://editorconfig.org — von IntelliJ, VS Code & Co. direkt gelesen.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile*]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
